<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home"
        android:orientation="vertical"
        >

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/poppinmedium"
            android:text="Kontrol"
            android:textColor="@color/hijau_end"
            android:textSize="20sp" />
        <ScrollView
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/layoutWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="#FFF8E1"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_warning"
                    app:tint="#F57C00"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Hubungkan Device ID terlebih dahulu untuk menggunakan fitur Kontrol."
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#F57C00"/>
            </LinearLayout>

        <!-- MODE -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            app:cardUseCompatPadding="true"
            android:layout_height="wrap_content"
            android:backgroundTint="@android:color/white"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_margin="12dp"
                >

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/mode" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppinmedium"
                    android:text="Mode : "
                    android:textColor="@color/hijau_end"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/mode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppinmedium"
                    android:text="Otomatis"
                    android:textColor="@color/hijau_end"
                    android:textSize="14sp"
                    android:textStyle="italic" />

                <LinearLayout
                    android:id="@+id/switchMode"
                    android:layout_width="50dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_switch_off"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <View
                        android:id="@+id/circleMode"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/bg_circle" />
                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvStatusMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="5dp"
            android:fontFamily="@font/poppinsregular"
            android:text="Sistem berjalan otomatis berdasarkan threshold"
            android:textColor="#666666"
            android:textSize="10sp"
            android:textStyle="italic" />

        <!-- ROW 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <!-- POMPA -->
            <androidx.cardview.widget.CardView
                android:id="@+id/pumpLayout"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardUseCompatPadding="true"
                android:backgroundTint="@android:color/white"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/pompa_air" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/poppinmedium"
                        android:text="Pompa Air"
                        android:textColor="#08AAA3"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:id="@+id/switchPump"
                        android:layout_width="50dp"
                        android:layout_height="26dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_switch_off"
                        android:orientation="horizontal"
                        android:padding="3dp">

                        <View
                            android:id="@+id/circlePump"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:background="@drawable/bg_circle" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/statusSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/poppinsbold"
                        android:text="-"
                        android:textColor="#08AAA3"
                        android:textSize="13sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- PH UP -->
            <androidx.cardview.widget.CardView
                android:id="@+id/phUpLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@android:color/white"
                app:cardCornerRadius="14dp"
                app:cardUseCompatPadding="true"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ph_up" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/poppinmedium"
                        android:text="Penambah pH"
                        android:textColor="#08AAA3"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:id="@+id/switchPhUp"
                        android:layout_width="50dp"
                        android:layout_height="26dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_switch_off"
                        android:orientation="horizontal"
                        android:padding="3dp">

                        <View
                            android:id="@+id/circlePhUp"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:background="@drawable/bg_circle" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/statusPhUp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/poppinsbold"
                        android:text="-"
                        android:textColor="#08AAA3"
                        android:textSize="13sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- PH DOWN -->
            <androidx.cardview.widget.CardView
                android:id="@+id/phDownLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardUseCompatPadding="true"
                android:backgroundTint="@android:color/white"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ph_down" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/poppinmedium"
                        android:text="Penurun pH"
                        android:textColor="#08AAA3"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:id="@+id/switchPhDown"
                        android:layout_width="50dp"
                        android:layout_height="26dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_switch_off"
                        android:orientation="horizontal"
                        android:padding="3dp">

                        <View
                            android:id="@+id/circlePhDown"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:background="@drawable/bg_circle" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/statusPhDown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/poppinsbold"
                        android:text="-"
                        android:textColor="#08AAA3"
                        android:textSize="13sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- ROW 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- NUTRISI UP -->
            <androidx.cardview.widget.CardView
                android:id="@+id/nutrisiUpLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@android:color/white"
                app:cardCornerRadius="14dp"
                app:cardUseCompatPadding="true"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/nutrisi_up" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/poppinmedium"
                        android:text="Nutrisi A"
                        android:textColor="#08AAA3"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/edtNutrisiA"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:hint="Masukkan mL"
                        android:inputType="number" />

                    <TextView
                        android:id="@+id/tvEstimasiA"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estimasi : 0 detik"
                        android:textSize="11sp"/>

                    <Button
                        android:id="@+id/btnTambahA"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="Tambahkan"
                        android:backgroundTint="#08AAA3"
                        android:textColor="#FFFFFF"/>

                    <TextView
                        android:id="@+id/tvStatusA"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Idle"
                        android:textColor="#08AAA3"
                        android:textStyle="bold"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- NUTRISI DOWN -->
            <androidx.cardview.widget.CardView
                android:id="@+id/nutrisiDownLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@android:color/white"
                app:cardCornerRadius="14dp"
                app:cardUseCompatPadding="true"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/nutrisi_down" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/poppinmedium"
                        android:text="Nutrisi B"
                        android:textColor="#08AAA3"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/edtNutrisiB"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:hint="Masukkan mL"
                        android:inputType="number"/>

                    <TextView
                        android:id="@+id/tvEstimasiB"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estimasi : 0 detik"
                        android:textSize="11sp"/>

                    <Button
                        android:id="@+id/btnTambahB"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="Tambahkan"
                        android:backgroundTint="#08AAA3"
                        android:textColor="#FFFFFF"/>

                    <TextView
                        android:id="@+id/tvStatusB"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Idle"
                        android:textColor="#08AAA3"
                        android:textStyle="bold"/>
                    </LinearLayout>


            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>